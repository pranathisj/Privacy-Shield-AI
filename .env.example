# Local mapping encryption: leave unset to generate a persistent local key in data/.mapping.key.
# Production: set PRIVACYSHIELD_ENCRYPTION_KEY to a Fernet key generated with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never commit .env or share this key.

# mock is a local demo provider; choose openai-compatible for a remote OpenAI-compatible API.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45

PRIVACYSHIELD_DATA_DIR=data
# Retain audit events and related local request/mapping records for this many days.
# Zero purges records on subsequent store operations.
PRIVACYSHIELD_RETENTION_DAYS=30
# Generate a local backend API key with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep this value private; Streamlit reads it server-side and sends it only to the backend.
PRIVACYSHIELD_API_KEY=

# Presidio enriches the India-focused pattern detector when the spaCy model is installed.
PRESIDIO_ENABLED=true
PRESIDIO_MODEL=en_core_web_sm
